# Neon PostgreSQL — pooled connection, used by Prisma Client at runtime.
# Development uses the Neon `development` branch; production uses `production`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/devdebug?sslmode=require"

# Neon unpooled connection, used by the Prisma CLI for migrations.
# Prisma 7 removed `directUrl`, so prisma.config.ts reads this directly.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devdebug?sslmode=require"

# NextAuth v5. Generate the secret with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app credentials. Callback URL in development:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Public origin used to build absolute links in emails. NextAuth reads it too.
# Must be the deployed origin in production, e.g. https://devdebug.app
AUTH_URL="http://localhost:3000"

# Resend. Transactional email (verification links).
RESEND_API_KEY=""

# Set to "false" to skip the verification email on signup and let new accounts
# sign in straight away. Needed until a domain is verified in Resend, because
# the shared onboarding@resend.dev sender only delivers to the address that owns
# the Resend account — everyone else would get an unusable account.
# Any other value, including unset, keeps verification on.
EMAIL_VERIFICATION_ENABLED="true"

# Upstash Redis. Rate limiting on the auth endpoints (sign-in, register,
# password reset, verification resend). Create a database at console.upstash.com
# and copy the REST credentials.
# Leaving these unset disables rate limiting entirely — every check allows the
# request — so local development works without an Upstash account.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
