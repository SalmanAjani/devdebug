# Neon PostgreSQL — pooled connection, used by Prisma Client at runtime.
# Development uses the Neon `development` branch; production uses `production`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/devdebug?sslmode=require"

# Neon unpooled connection, used by the Prisma CLI for migrations.
# Prisma 7 removed `directUrl`, so prisma.config.ts reads this directly.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devdebug?sslmode=require"
